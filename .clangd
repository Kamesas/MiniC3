# clangd reads compile_commands.json (generated by `pio run -t compiledb`),
# but that DB carries GCC-only flags that clang's driver rejects. Strip them
# so clangd can parse the translation units cleanly.
CompileFlags:
  Remove:
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -mtext-section-literals  # xtensa boards (ESP32/S2/S3), harmless here
    - -free                    # extra GCC opts that may appear in other envs
    - -fipa-pta

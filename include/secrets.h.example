// secrets.h.example
//
// Template for include/secrets.h. Copy this file to include/secrets.h
// and fill in the real values. The real secrets.h is gitignored so
// your credentials never end up in version control.
//
//   cp include/secrets.h.example include/secrets.h
//   # then edit include/secrets.h

#pragma once

#define WIFI_SSID     "your-2.4GHz-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// POSIX timezone string. Examples:
//   "EET-2EEST,M3.5.0/3,M10.5.0/4"  Europe/Kyiv (UTC+2, DST UTC+3)
//   "CET-1CEST,M3.5.0,M10.5.0/3"    Europe/Berlin (UTC+1, DST UTC+2)
//   "UTC0"                          UTC, no DST
//   "EST5EDT,M3.2.0,M11.1.0"        US Eastern
#define TIMEZONE "EET-2EEST,M3.5.0/3,M10.5.0/4"
